from ScibConfig import *

cfg = ParsedConfig(config)
prep_func, prep_wildcards = cfg.get_all_preprocessing_wildcards()

rule preprocessing:
    input:
        adata  = lambda wildcards: cfg.get_from_scenario(wildcards.scenario, key="file")
    output: cfg.ROOT / "{scenario}/prepare/{scaling}/{hvg}/adata_pre.{prep}"
    message:
        """
        Preparing adata
        wildcards: {wildcards}
        parameters: {params}
        output: {output}
        """
    params:
        batch_key = lambda wildcards: cfg.get_from_scenario(wildcards.scenario, key="batch_key"),
        hvgs      = lambda wildcards: cfg.get_feature_selection(wildcards.hvg),
        scale     = lambda wildcards: wildcards.scaling == "scaled",
        rout      = lambda wildcards: wildcards.prep == "RDS",
        seurat    = lambda wildcards: wildcards.prep == "RDS"
    benchmark:
        str(cfg.ROOT / "{scenario}/prepare/{scaling}/{hvg}/prep_{prep}.benchmark")
        #join_path(cfg.get_filename_pattern("prepare", "directory_by_setting"), "prep_{prep}.benchmark")
    conda: cfg.py_env
    threads: 4
    script:
        "runPP.py"


rule all:
    input:
        expand(rules.preprocessing.output, prep_func, **prep_wildcards)
    message: "Preprocessing done"